{
  "hosting": {
    "site": "one-button-jay",
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "**/.*/**", "**/node_modules/**", "*.md", "*.ps1", "server/**", "LICENSE"],
    "headers": [
      { "source": "**/*.@(html|js|json)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ],
    "rewrites": [
      { "source": "/api/chat", "function": "oneButton", "region": "us-central1" },
      { "source": "/api/transcribe", "function": "oneButton", "region": "us-central1" },
      { "source": "/api/sync", "function": "oneButton", "region": "us-central1" },
      { "source": "/api/interview/**", "function": "oneButton", "region": "us-central1" },
      { "source": "/api/space/**", "function": "oneButton", "region": "us-central1" },
      { "source": "/api/shop/**", "function": "oneButton", "region": "us-central1" },
      { "source": "/api/project/**", "function": "oneButton", "region": "us-central1" },
      { "source": "/api/person/**", "function": "oneButton", "region": "us-central1" },
      { "source": "/api/clip", "function": "oneButton", "region": "us-central1" },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}